@{
    ViewData["Title"] = "Портфолио";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Категории</title>
    <!-- Подключение библиотек Bootstrap -->

</head>
<body>

    <div class="container mt-4 custom-container">
        <h3>Категории</h3>

        <!-- Навигация по категориям -->
        <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="pills-all-tab" data-bs-toggle="pill" data-bs-target="#pills-all" type="button" role="tab">Все</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-interiors-tab" data-bs-toggle="pill" data-bs-target="#pills-interiors" type="button" role="tab">Фасадные панели</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-exteriors-tab" data-bs-toggle="pill" data-bs-target="#pills-exteriors" type="button" role="tab">Экстерьеры</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="pills-renovations-tab" data-bs-toggle="pill" data-bs-target="#pills-renovations" type="button" role="tab">Ремонт</button>
            </li>
        </ul>

        <!-- Галерея изображений по категориям -->
        <div class="tab-content">
            <div class="tab-pane fade show active" id="pills-all" role="tabpanel">
                <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
                    <!-- Индикаторы (точки для навигации) -->
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="3" aria-label="Slide 4"></button>
                    </div>

                    <!-- Слайды -->
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="/images/фасадные панели/p1.png" class="d-block w-100" alt="Фасадные панели 1">
                            <div class="carousel-caption d-none d-md-block">
                                <p>Фасад 1</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="/images/фасадные панели/p10.png" class="d-block w-100" alt="Экстерьер 1">
                            <div class="carousel-caption d-none d-md-block">
                                <p>Фасад 2</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="/images/фасадные панели/p100.png" class="d-block w-100" alt="Ремонт 1">
                            <div class="carousel-caption d-none d-md-block">
                                <p>Фасад 3</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="/images/фасадные панели/p101.png" class="d-block w-100" alt="Фасад 4">
                            <div class="carousel-caption d-none d-md-block">
                                <p>Фасад 4</p>
                            </div>
                        </div>
                    </div>

                    <!-- Кнопки переключения -->
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
<style>
    /* Стиль для заголовка h3 */
    h3 {
        color: white; /* Черный цвет для заголовка */
    }
</style>
<style>
    /* Объединяем все стили в один блок */
    h3 {
        color: #333;
        margin-bottom: 20px;
    }

    .container {
        margin-top: 20px;
    }

    /* Стили для вкладок */
    .nav-pills .nav-link {
        color: #333 !important; /* Темный цвет для неактивных вкладок */
        background-color: #f8f9fa;
        border-radius: 0.25rem;
        transition: all 0.3s ease;
        border: 1px solid #dee2e6;
        margin: 0 5px;
    }

        .nav-pills .nav-link.active {
            background-color: #007bff !important;
            color: white !important;
            border-color: #007bff;
        }

        /* Эффекты при наведении */
        .nav-pills .nav-link:not(.active):hover {
            background-color: #e9ecef;
            color: #212529 !important;
        }

    /* Стили для карусели */
    .carousel-item img {
        max-width: 100%;
        height: auto;
        border: 1px solid #ddd;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
        border-radius: 0.5rem;
    }

        .carousel-item img:hover {
            transform: scale(1.03);
        }

    .carousel-caption p {
        background: rgba(0, 0, 0, 0.6);
        padding: 8px 15px;
        display: inline-block;
        border-radius: 4px;
        font-size: 1.1rem;
    }

    /* Убираем лишнюю закрывающую скобку */
</style>