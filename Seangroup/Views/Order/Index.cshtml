@model Order

<h2>Оформление заказа</h2>

<form asp-action="Checkout" method="post">
    <div class="form-group">
        <label>Способ получения:</label>
        <select asp-for="DeliveryMethod" class="form-control" id="deliveryMethod">
            <option value="Самовывоз">Самовывоз</option>
            <option value="Доставка">Доставка</option>
        </select>
    </div>

    <div class="form-group" id="deliveryAddressGroup" style="display: none;">
        <label>Адрес доставки:</label>
        <input asp-for="DeliveryAddress" class="form-control" />
        <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
    </div>

    <h4 class="mt-4">Товары в заказе:</h4>
    <ul class="list-group">
        @foreach (var item in ViewBag.CartItems)
        {
            <li class="list-group-item">
                @item.Product.Name x @item.Quantity (Цена: @((item.Price * item.Quantity).ToString("C"))
            </li>
        }
    </ul>

    <button type="submit" class="btn btn-success mt-3">Подтвердить заказ</button>
</form>

@section Scripts {
    <script>
        document.getElementById('deliveryMethod').addEventListener('change', function() {
            const addressGroup = document.getElementById('deliveryAddressGroup');
            addressGroup.style.display = this.value === 'Доставка' ? 'block' : 'none';
        });
    </script>
}