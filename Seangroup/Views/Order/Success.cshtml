@{
    ViewData["Title"] = "Подтверждение заказа";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Заказ №@Model.Id успешно оформлен!</h2>

    <div class="card shadow">
        <div class="card-body">
            <h4 class="card-title">Детали заказа:</h4>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <strong>Статус:</strong> @Model.Status
                </li>
                <li class="list-group-item">
                    <strong>Способ получения:</strong> @Model.DeliveryMethod
                </li>
                @if (Model.DeliveryMethod == "Доставка")
                {
                    <li class="list-group-item">
                        <strong>Адрес доставки:</strong> @Model.DeliveryAddress
                    </li>
                }
                <li class="list-group-item">
                    <strong>Дата заказа:</strong> @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")
                </li>
            </ul>

            <h4 class="mt-4">Товары:</h4>
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Товар</th>
                        <th>Количество</th>
                        <th>Цена</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>@item.Price.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="text-end mt-4">
                <a href="/" class="btn btn-primary">Вернуться в магазин</a>
            </div>
        </div>
    </div>
</div>