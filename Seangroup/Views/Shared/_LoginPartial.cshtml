@using Microsoft.AspNetCore.Identity
@using Seangroup.Areas.Identity.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {

        <li class="nav-item me-3">
            <a class="btn btn-outline-secondary position-relative"
               asp-controller="Cart"
               asp-action="Index"
               title="Shopping Cart"
               aria-label="View shopping cart">
                <i class="bi bi-cart3"></i>
                @if (ViewBag.CartItemCount > 0)
                {
                    <span class="badge bg-primary rounded-pill position-absolute top-0 start-100 translate-middle">
                        @ViewBag.CartItemCount
                    </span>
                }
            </a>
        </li>


        <!-- Выпадающее меню пользователя -->
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center"
               href="#"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">
                <i class="bi bi-person-circle me-2"></i>
                @UserManager.GetUserName(User)
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <!-- Админ-панель (только для админов) -->
                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a class="dropdown-item text-danger"
                           asp-controller="Admin"
                           asp-action="Orders">
                            <i class="bi bi-shield-lock me-2"></i>Админ-панель
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                }
                <li>
                    <a class="dropdown-item"
                       asp-controller="Order"
                       asp-action="UserOrders">
                        <i class="bi bi-cart-check me-2"></i>Мои заказы
                    </a>
                </li>
                <li>
                    <a class="dropdown-item"
                       asp-area="Identity"
                       asp-page="/Account/Manage/Index">
                        <i class="bi bi-gear me-2"></i>Управление аккаунтом
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Product", new { area = "" })">
                        <button type="submit"
                                class="dropdown-item text-danger"
                                aria-label="Log out">
                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <!-- Группа кнопок авторизации -->
        <div class="d-flex gap-2">
        <li class="nav-item">
            <a class="btn btn-outline-primary"
               id="register"
               asp-area="Identity"
               asp-page="/Account/Register">
                <i class="bi bi-person-plus me-2"></i>Зарегистрироваться
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-primary"
               id="login"
               asp-area="Identity"
               asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-2"></i>Войти
            </a>
        </li>
        </div>
    }
</ul>

