@model Product

<h2>Удалить товар</h2>

<p>Вы уверены, что хотите удалить товар "@Model.Name"?</p>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Отмена</a>
</form>