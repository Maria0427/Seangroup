@model Product

@{
    ViewData["Title"] = "Редактирование товара";
}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<h2>Редактирование товара</h2>

<form asp-action="Edit" class="mt-4">
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-8">
            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label">Название</label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price" class="form-label">Цена</label>
                <input asp-for="Price" class="form-control" required type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label">Описание</label>
                <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="ImageUrl" class="form-label">Ссылка на изображение</label>
                <input asp-for="ImageUrl" class="form-control" type="url" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Характеристики</h5>
                </div>
                <div class="card-body">
                    <div id="productDetails">
                        @for (var i = 0; i < Model.ProductDetails.Count; i++)
                        {
                            <div class="detail-row mb-3">
                                <input type="hidden" asp-for="ProductDetails[i].Id" />
                                <div class="input-group">
                                    <input asp-for="ProductDetails[i].AttributeName"
                                           class="form-control mb-1"
                                           placeholder="Название характеристики" />
                                    <input asp-for="ProductDetails[i].AttributeValue"
                                           class="form-control"
                                           placeholder="Значение" />
                                    <button type="button"
                                            class="btn btn-outline-danger remove-detail"
                                            title="Удалить характеристику">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                    <button type="button"
                            id="addDetail"
                            class="btn btn-success btn-sm mt-2">
                        <i class="bi bi-plus-circle"></i> Добавить характеристику
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="form-group mt-4">
        <button type="submit" class="btn btn-primary px-5">
            <i class="bi bi-save"></i> Сохранить изменения
        </button>
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Добавление новой характеристики
            $('#addDetail').on('click', function() {
                const container = $('#productDetails');
                const index = container.find('.detail-row').length;

                const template = `
                    <div class="detail-row mb-3">
                        <input type="hidden" name="ProductDetails[${index}].Id" value="0" />
                        <div class="input-group">
                            <input name="ProductDetails[${index}].AttributeName"
                                   class="form-control mb-1"
                                   placeholder="Название характеристики" />
                            <input name="ProductDetails[${index}].AttributeValue"
                                   class="form-control"
                                   placeholder="Значение" />
                            <button type="button"
                                    class="btn btn-outline-danger remove-detail"
                                    title="Удалить характеристику">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                `;

                container.append(template);
            });

            // Удаление характеристики (делегирование событий)
            $('#productDetails').on('click', '.remove-detail', function() {
                $(this).closest('.detail-row').remove();
                updateIndices();
            });

            // Обновление индексов
            function updateIndices() {
                $('#productDetails .detail-row').each(function(index) {
                    $(this).find('input').each(function() {
                        const name = $(this).attr('name')
                            .replace(/\[\d+\]/, `[${index}]`);
                        $(this).attr('name', name);
                    });
                });
            }
        });
    </script>

}