@model IEnumerable<Order>

@{
    ViewData["Title"] = "Все заказы";
}

<div class="container mt-5">
    <h2 class="mb-4">Список заказов</h2>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>№</th>
                <th>Клиент</th> <!-- Новая колонка -->
                <th>Телефон</th> <!-- Новая колонка -->
                <th>Дата</th>
                <th>Статус</th>
                <th>Способ получения</th>
                <th>Сумма</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>
                        @order.User?.FirstName @order.User?.LastName
                        <div class="text-muted small">@order.User?.Email</div>
                    </td>
                    <td>@order.User?.PhoneNumber</td>
                    <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@order.Status</td>
                    <td>@order.DeliveryMethod</td>
                    <td>@order.OrderItems.Sum(i => i.Price * i.Quantity).ToString("C")</td>
                    <td>
                        <a asp-action="OrderDetails" asp-route-id="@order.Id"
                           class="btn btn-sm btn-info">
                            Детали
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </table>
</div>