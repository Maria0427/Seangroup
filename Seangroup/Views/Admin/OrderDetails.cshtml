@model Order

@{
    ViewData["Title"] = "Детали заказа";
}

<div class="container mt-5">
    <h2 class="mb-4">Детали заказа №@Model.Id</h2>

    <div class="card shadow">
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h5>Основная информация:</h5>
                    <ul class="list-group">
                        <li class="list-group-item">
                            <strong>Статус:</strong>
                            <form asp-action="UpdateOrderStatus" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <select name="newStatus" class="form-select d-inline w-auto">
                                    <option value="Оформлен" selected="@(Model.Status == "Оформлен")">Оформлен</option>
                                    <option value="В обработке" selected="@(Model.Status == "В обработке")">В обработке</option>
                                    <option value="Доставляется" selected="@(Model.Status == "Доставляется")">Доставляется</option>
                                    <option value="Завершен" selected="@(Model.Status == "Завершен")">Завершен</option>
                                    <option value="Отменен" selected="@(Model.Status == "Отменен")">Отменен</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-primary ms-2">Обновить</button>
                            </form>
                        </li>
                    </ul>
                </div>
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h5>Информация о клиенте:</h5>
                        <ul class="list-group">
                            <li class="list-group-item">
                                <strong>Имя:</strong> @Model.User?.FirstName @Model.User?.LastName
                            </li>
                            <li class="list-group-item">
                                <strong>Email:</strong> @Model.User?.Email
                            </li>
                            <li class="list-group-item">
                                <strong>Телефон:</strong> @Model.User?.PhoneNumber
                            </li>
                        </ul>
                    </div>
                    <!-- Остальные блоки остаются без изменений -->
                </div>
                <div class="col-md-6">
                    <h5>Дополнительно:</h5>
                    <ul class="list-group">
                        <li class="list-group-item">
                            <strong>Дата заказа:</strong> @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")
                        </li>
                        <li class="list-group-item">
                            <strong>Общая сумма:</strong> @Model.OrderItems.Sum(i => i.Price * i.Quantity).ToString("C")
                        </li>
                    </ul>
                </div>
            </div>

            <h4 class="mt-4">Товары:</h4>
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Товар</th>
                        <th>Количество</th>
                        <th>Цена за шт.</th>
                        <th>Сумма</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>@item.Price.ToString("C")</td>
                            <td>@((item.Price * item.Quantity).ToString("C"))</td>
                        </tr>
                    }
                </tbody>
            </table>


            <div class="mt-4">
                <a asp-action="Orders" class="btn btn-secondary">Назад к списку</a>
            </div>
        </div>
    </div>
</div>